# Copia este archivo como ".env" y completa SOLO el proveedor que vayas a usar.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Proveedor de IA: "anthropic" (Claude) o "gemini" (Google Gemini)
AI_PROVIDER=anthropic

# --- Claude (Anthropic) --- clave en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Gemini (Google) --- clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos vigentes: gemini-3.8-flash (rápido, recomendado), gemini-4-argon (más potente).
# Los modelos antiguos (como gemini-2.5-flash) fueron retirados. Verifica el nombre en https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Opcionales
PORT=3000
IA_TIMEOUT_MS=30000
